+++ b/umamo/src/main/kotlin/org/umamo/format/moc3/encode/MocPositionDedup.kt
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package org.umamo.format.moc3.encode
+
+import org.umamo.format.moc3.model.BlendShapeKeyform
+
+// Opt-in lossless packing. Preserve every keyform row and scalar channel;
+// only byte-identical, consecutive position blocks share their existing index.
+internal fun positionDedupEnabled(): Boolean =
+    java.lang.Boolean.getBoolean("popy.moc3.deduplicatePositions")
+
+internal fun samePositionBits(a: FloatArray?, b: FloatArray): Boolean {
+    if(a == null || a.size != b.size) return false
+    if(a === b) return true
+    for(i in b.indices) if(a[i].toRawBits() != b[i].toRawBits()) return false
+    return true
+}
+
+internal fun deduplicatedPositionFloatCount(context: MocLoweringContext): Int {
+    var previous: FloatArray? = null
+    var count = 0
+    fun add(values: FloatArray) {
+        if(!samePositionBits(previous, values)) count += (values.size + 15) / 16 * 16
+        previous = values
+    }
+    for(warp in context.warps) for(form in warp.keyforms) add(form.controlPoints)
+    for(mesh in context.doc.artMeshes) for(form in mesh.keyforms) add(form.vertexPositions)
+    if(context.hasBlendShapes) {
+        for(record in context.blendLayout.warpRecords) for(form in record.keyforms) {
+            if(form is BlendShapeKeyform.Warp) add(form.form.controlPoints)
+        }
+        for(record in context.blendLayout.meshRecords) for(form in record.keyforms) {
+            if(form is BlendShapeKeyform.Mesh) add(form.form.vertexPositions)
+        }
+    }
+    return count
+}
